# Commerce (optional)
# NEXT_PUBLIC_COMMERCE_OPTIMIZER_URL=
# NEXT_PUBLIC_CATALOG_VIEW_ID=

# Auth – Sign in with Adobe (optional)
# ADOBE_CLIENT_ID=
# ADOBE_CLIENT_SECRET=
# AUTH_SECRET=
# ADOBE_IMS_ORG_ID=

# Universal Editor – localhost / local AEM
# Use when opening this app in Universal Editor from localhost (e.g. https://localhost:3000).
# Recommended for local UE: use a tunnel (npm run tunnel) and set preview URL in AEM to the tunnel URL (see docs/universal-editor-tunnel.md).
#
# Default AEM author URL used for the connection meta tag and when no value is in app config (localStorage).
# For local AEM SDK behind local-ssl-proxy (e.g. 8443 -> 4502), set to your HTTPS local author URL.
# NEXT_PUBLIC_AEM_EDITOR_URL=https://localhost:8443
#
# When using a local Universal Editor service (from Software Distribution), set to its CORS script URL.
# NEXT_PUBLIC_UE_CORS_SCRIPT_URL=https://localhost:8001/cors.js
#
# Default AEM project name when app is opened in Universal Editor (iframe) and no value is in localStorage.
# NEXT_PUBLIC_AEM_PROJECT=v0

# Amplience (Content Studio visualization and toolbar)
# Hub name for Content Delivery API; used when fetching content and in visualization URLs.
# NEXT_PUBLIC_AMPLIENCE_HUB=your-hub-name
# For in-page carousel editing (save to Amplience): Content Management API credentials.
# AMPLIENCE_CLIENT_ID=
# AMPLIENCE_CLIENT_SECRET=
# For creating content from drop zones (Banner, Carousel): Content repository ID from your Amplience hub.
# AMPLIENCE_CONTENT_REPOSITORY_ID=
# Base URL of this storefront (for visualization URL registration in Amplience content types).
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: URLs for toolbar Sites (skins). See config/amplience-skins.js.
# NEXT_PUBLIC_PROD_APP_URL=https://your-storefront.com
# NEXT_PUBLIC_UAT_APP_URL=https://uat.your-storefront.com
# NEXT_PUBLIC_STAGING_APP_URL=https://staging.your-storefront.com
