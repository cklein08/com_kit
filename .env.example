# Commerce (optional)
# NEXT_PUBLIC_COMMERCE_OPTIMIZER_URL=
# NEXT_PUBLIC_CATALOG_VIEW_ID=

# Auth – Sign in with Adobe (optional)
# ADOBE_CLIENT_ID=
# ADOBE_CLIENT_SECRET=
# AUTH_SECRET=
# ADOBE_IMS_ORG_ID=

# Universal Editor – localhost / local AEM
# Use when opening this app in Universal Editor from localhost (e.g. https://localhost:3000).
# Universal Editor requires the app to be served over HTTPS; run `npm run dev:https` for local dev.
#
# Default AEM author URL used for the connection meta tag and when no value is in app config (localStorage).
# For local AEM SDK behind local-ssl-proxy (e.g. 8443 -> 4502), set to your HTTPS local author URL.
# NEXT_PUBLIC_AEM_EDITOR_URL=https://localhost:8443
#
# When using a local Universal Editor service (from Software Distribution), set to its CORS script URL.
# NEXT_PUBLIC_UE_CORS_SCRIPT_URL=https://localhost:8001/cors.js
